# Dependencies — re-downloadable any time via `npm install` from package.json.
# Huge (~150 MB) and reproducible, so we NEVER commit them.
node_modules/

# Build output — the packaged .app produced by electron-builder.
# Also regenerated on demand, so it stays out of the repo.
dist/

# macOS clutter — Finder drops these hidden files everywhere; not part of the app.
.DS_Store

# Nested checkout of the separate `life-os-bot` repo (its own .git lives inside).
# It just happens to sit here on disk — it is NOT part of this app and must never
# be committed/pushed with clippy-widget.
substrate-clippy/
